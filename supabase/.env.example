# Copy to supabase/.env (git-ignored) and fill in. Never commit real keys.
# The Edge Functions need NO custom secrets: the Edge Runtime injects
# SUPABASE_URL and SUPABASE_ANON_KEY automatically, both locally
# (`supabase functions serve`) and when deployed.
#
# These two are only used by the end-to-end smoke test
# (supabase/functions/tests/e2e_smoke.ts) and are never committed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from `supabase status` or the dashboard>
